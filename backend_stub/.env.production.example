# Brevo / SMTP — required for HTML welcome email, password reset, notifications
# Use a transactional relay (Brevo, SendGrid, etc.) — NOT your mailbox host unless its IP
# allowlist includes the API server. Error 525 "Unauthorized IP" means the relay rejected
# the server's IP; fix in Brevo (verified domain + SMTP key) or whitelist IP at your provider.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@shiftswifthr.co.uk
SMTP_FROM_NAME="ShiftSwift HR"
SMTP_REPLY_NAME="ShiftSwift HR Support"
EMAIL_LOGO_URL=https://app.shiftswifthr.co.uk/assets/shiftswift-hr-logo.png
SMTP_USE_TLS=1
EMAIL_SUPPORT=support@shiftswifthr.co.uk
VAPID_CONTACT_EMAIL=mailto:support@shiftswifthr.co.uk

# Web Push — employee shift reminders (generate keys once; see scripts/check_push_setup.sh)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Native iOS push (APNs Auth Key .p8 — store outside git; sandbox=false in production)
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=co.uk.shiftswifthr.app
APNS_USE_SANDBOX=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TAX_ENABLED=1
STRIPE_CURRENCY=gbp
# Per-head platform plans (base + seat prices — see billing_config.py)
STRIPE_PRICE_ESSENTIALS_BASE_MONTHLY=
STRIPE_PRICE_ESSENTIALS_SEAT_MONTHLY=
STRIPE_PRICE_COMPLIANCE_BASE_MONTHLY=
STRIPE_PRICE_COMPLIANCE_SEAT_MONTHLY=
STRIPE_PRICE_MULTISITE_BASE_MONTHLY=
STRIPE_PRICE_MULTISITE_SEAT_MONTHLY=
# Legacy payroll add-on prices (optional; payroll module separate from HR platform)
