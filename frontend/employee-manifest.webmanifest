{
  "id": "/sign-in.html",
  "name": "ShiftSwift Employee",
  "short_name": "Employee",
  "description": "Clock in, view payslips, documents, and your shift schedule.",
  "start_url": "./sign-in.html?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#0f6e56",
  "theme_color": "#0f6e56",
  "categories": ["business", "productivity"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "./assets/shiftswift-employee-app-icon-180.png?v=brandkit-v7",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/shiftswift-employee-app-icon-192.png?v=brandkit-v6",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/shiftswift-employee-app-icon.png?v=brandkit-v6",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/shiftswift-hr-app-icon-maskable.png?v=brandkit-v6",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Clock in",
      "short_name": "Clock",
      "url": "./employee.html?source=shortcut#time-clock",
      "icons": [
        {
          "src": "./assets/shiftswift-employee-app-icon-192.png?v=brandkit-v6",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "My payslips",
      "short_name": "Payslips",
      "url": "./employee.html?source=shortcut#payslips",
      "icons": [
        {
          "src": "./assets/shiftswift-employee-app-icon-192.png?v=brandkit-v6",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
