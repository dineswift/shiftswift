{
  "name": "shiftswifthr-iphone-app",
  "private": true,
  "version": "1.4.0",
  "description": "ShiftSwift HR — iOS Capacitor app (bundled login + employee/admin portals)",
  "scripts": {
    "sync:www": "node scripts/sync-www.mjs",
    "sync:ios": "npm run sync:www && npx cap sync ios",
    "brand:ios": "node scripts/apply-branding.mjs",
    "ios:open": "npx cap open ios",
    "ios:run": "npx cap run ios",
    "ios:deploy": "npm run sync:ios && npm run brand:ios && npx cap run ios",
    "ios:ipad": "bash scripts/run-ipad-simulator.sh",
    "ios:device": "bash scripts/run-device.sh",
    "ios:repair-pods": "bash scripts/repair-ios-pods.sh",
    "ios:sync": "npm run sync:www && rsync -a www/ ios/App/App/public/ && xattr -cr www ios/App/App/public 2>/dev/null || true",
    "screenshots:prepare": "python3 scripts/prepare-app-store-screenshots.py",
    "appstore:icon": "python3 scripts/prepare-app-store-screenshots.py --icon-only",
    "screenshots:capture": "node scripts/capture-real-screenshots.mjs",
    "appstore:archive": "bash scripts/archive-for-app-store.sh",
    "appstore:upload": "bash scripts/upload-to-app-store-connect.sh",
    "appstore:release": "npm run appstore:archive && npm run appstore:upload",
    "appstore:prepare": "npm run screenshots:prepare && npm run appstore:archive"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/core": "^7.6.7",
    "@capacitor/geolocation": "^7.1.8",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/ios": "^7.6.7",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/local-notifications": "^7.0.6",
    "@capacitor/preferences": "^7.0.4",
    "@capacitor/push-notifications": "^7.0.7",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.7",
    "typescript": "^6.0.3"
  }
}
